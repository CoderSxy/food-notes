# Optional override; default https://{accountId}.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Optional Nominatim origin or prefix (no trailing /reverse). Default:
# https://nominatim.openstreetmap.org
# NOMINATIM_BASE_URL=
